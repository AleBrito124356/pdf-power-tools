# pdf-power-tools configuration.
# Copy this file to .env (cp .env.example .env) and edit as needed.
# Everything here is OPTIONAL — the tool works with no configuration at all.
# Values already set in your shell environment take precedence over this file.

# Path to the Tesseract OCR executable, only needed if it is NOT on your PATH.
# Tesseract is a native program, not a pip package — install it separately:
#   Windows : winget install UB-Mannheim.TesseractOCR
#             (installer: https://github.com/UB-Mannheim/tesseract/wiki)
#   macOS   : brew install tesseract
#   Linux   : sudo apt install tesseract-ocr
# Then point this at the binary if `pdftool doctor` cannot find it:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
